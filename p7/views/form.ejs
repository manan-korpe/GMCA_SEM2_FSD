<!DOCTYPE html>
<html>
<head>
  <title>Library Book Entry</title>
  <style>
    body { font-family: Arial; padding: 30px; background:#f4f4f4; }
    .box { background:white; padding:20px; width:300px; margin:auto; border-radius:10px; }
    input, button {
      width:100%; padding:10px; margin:5px 0;
    }
    button { background:#00adb5; color:white; border:none; cursor:pointer; }
  </style>
</head>
<body>

<div class="box">
  <h2>Library Book Entry</h2>

  <form action="/submit" method="POST">
    <input type="text" name="title" placeholder="Book Title" required>
    <input type="text" name="author" placeholder="Author Name" required>
    <input type="number" name="year" placeholder="Year Published" required>
    <input type="text" name="category" placeholder="Category" required>

    <button type="submit">Submit</button>
  </form>
</div>

</body>
</html>