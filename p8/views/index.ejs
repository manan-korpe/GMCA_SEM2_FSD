<!DOCTYPE html>
<html>

<head>
    <title>practical-8</title>
</head>

<body>
    <form method="post">
        
    <h1>Online quiz <%= quizTitle%>
    </h1>
    <h3>total questions: <%= totalQuestions%>
    </h3>
    <% questions.forEach(i=>{ %>
        <h4>
            <%= i.id %>) <%= i.question %>
        </h4>
        <ul type="none">
            <% i.options.forEach(o=> { %>
                <li>
                    <input type="radio" name="<%= i.id%>" value="<%= o%>"> <%= o %>
                </li>
                <% }) %>
        </ul>
    <% }) %>
    <button>submit</button>
    </form>
</body>

</html>